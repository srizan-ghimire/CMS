# Destination for the rewrites in next.config.mjs, which forward /api/auth/* and /api/v1/* to the
# NestJS API. Server-side only, so this may be an internal hostname.
API_URL=http://localhost:4000

# The origin the BROWSER talks to the API on. Read by api-client.ts and auth-client.ts.
#
# This is a NEXT_PUBLIC_ variable, so it is inlined into the client bundle at BUILD time — in a
# container it must be passed as a Docker build ARG, and changing it needs a rebuild, not a
# restart. Three meaningful values:
#   http://localhost:4000   local dev, API on its own port
#   (empty)                 same-origin: calls go to /api/v1/... and the rewrites forward them
#   https://api.example.com direct, for sibling subdomains sharing AUTH_COOKIE_DOMAIN
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public origin of this app. Used for canonical/OpenGraph URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
