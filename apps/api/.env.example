# ---- App ----
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://social:social@localhost:5432/social_platform?schema=public

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379

# ---- Auth (Better Auth) ----
BETTER_AUTH_SECRET=replace_with_openssl_rand_hex_32
# The origin the BROWSER reaches Better Auth on. Verification and password-reset links are built
# from this, so pointing it at an origin the user cannot open dead-ends every signup.
BETTER_AUTH_URL=http://localhost:4000
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated origins allowed by CORS and Better Auth's CSRF origin check. Defaults to WEB_URL.
TRUSTED_ORIGINS=

# Session cookie scope. Leave empty when the web app and API share an origin. Set to a leading-dot
# parent (".example.com") to share the cookie between app.example.com and api.example.com — which
# a split-host deployment REQUIRES, because apps/web/src/middleware.ts reads the session cookie
# from the web origin and will redirect-loop without it. It can never be a public suffix such as
# ".onrender.com"; browsers reject that Set-Cookie outright.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=lax

# Social login. Entirely optional: a provider is registered only when its CLIENT_ID is present,
# and the sign-in page asks /api/v1/auth/providers which ones exist, so leaving these blank hides
# the buttons rather than showing ones that 404.
# Authorized redirect URI to register with each provider:
#   {BETTER_AUTH_URL}/api/auth/callback/google
#   {BETTER_AUTH_URL}/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Object Storage (S3-compatible / MinIO locally) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=social_minio
S3_SECRET_ACCESS_KEY=social_minio_secret
S3_BUCKET=social-platform-media
S3_FORCE_PATH_STYLE=true
# Origin the BROWSER reaches storage on for PRESIGNED urls. Differs from S3_ENDPOINT when the API
# runs in Docker (api -> http://minio:9000, browser -> http://localhost:9000).
#
# MinIO only. Rewriting a presigned URL's host works there because MinIO does not verify the Host
# header, but `host` IS a signed header under real SigV4 — on Cloudflare R2 or AWS S3 the same
# rewrite yields SignatureDoesNotMatch. Leave this EMPTY on R2/S3 and use S3_PUBLIC_READ_URL for
# the public media domain instead. The app rejects the unsafe combination at boot.
S3_PUBLIC_URL=http://localhost:9000

# Origin that UNSIGNED, public object reads are served from — an R2 custom domain, an r2.dev
# subdomain, or a public MinIO. Bucket-rooted: no /<bucket>/ path segment. Persisted into
# MediaAsset.url, so changing it after go-live means backfilling that column.
S3_PUBLIC_READ_URL=

# ---- Media ----
# Internet-reachable base URL that Meta/TikTok can DOWNLOAD media from. Instagram and Facebook
# publish by handing the platform a URL their own servers fetch, so http://localhost is unusable.
# Leave EMPTY locally: the publish pipeline then uses the stub publisher instead of failing inside
# a queue job. For real end-to-end tests, point this at a tunnel (cloudflared/ngrok) to MinIO.
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_UPLOAD_BYTES=1073741824
MEDIA_SIGNED_URL_TTL_SECONDS=3600

# ---- Email (Mailhog locally) ----
# emailAndPassword.requireEmailVerification is ON, so a broken transport blocks every signup.
# In production a real host is mandatory — the config schema rejects a loopback SMTP_HOST there.
# SMTP_SECURE is implicit TLS (port 465 only); 587 negotiates STARTTLS and must leave it false.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@socialplatform.dev

# ---- Token encryption ----
# AES-256-GCM key used to encrypt stored social OAuth tokens at rest. Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=replace_with_openssl_rand_hex_32

# ---- Social OAuth (per-platform apps, launch scope) ----
# Facebook Login covers both Facebook Page connections AND Instagram (a Business/Creator IG
# account is discovered through its linked Facebook Page during the same OAuth grant — Meta
# does not offer a separate standalone Instagram OAuth app). Configure redirect URI in the
# Meta App Dashboard as: {API_URL}/api/v1/social-accounts/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0

# Configure redirect URI in the TikTok Developer Portal (Login Kit > Web) as:
#   {API_URL}/api/v1/social-accounts/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- AI ----
# Gates the caption assistant, together with the `ai_agents` feature flag.
ANTHROPIC_API_KEY=

# ---- Operational toggles ----
# Swagger at /api/docs publishes the entire API surface; it is off in production unless this is
# "true". Always on outside production.
ENABLE_SWAGGER=false
# The container entrypoint runs `prisma migrate deploy` before starting. Set false only if
# migrations are applied out of band — never both.
RUN_MIGRATIONS_ON_BOOT=true
