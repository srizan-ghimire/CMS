# This file documents every variable used across the system. It is NOT read directly —
# pnpm runs each app's scripts with that app's folder as the working directory, so:
#   - copy the API_/DATABASE_/REDIS_/AUTH_/S3_/AI_ vars below into apps/api/.env
#   - copy the API_URL / NEXT_PUBLIC_ vars into apps/web/.env.local
# (apps/api/.env.example and apps/web/.env.example already split these out for you.)

# ---- App ----
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://social:social@localhost:5432/social_platform?schema=public

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379

# ---- Auth (Better Auth) ----
BETTER_AUTH_SECRET=replace_with_openssl_rand_hex_32
BETTER_AUTH_URL=http://localhost:4000
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Object Storage (S3-compatible / MinIO locally) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=social_minio
S3_SECRET_ACCESS_KEY=social_minio_secret
S3_BUCKET=social-platform-media
S3_FORCE_PATH_STYLE=true

# ---- Email (Mailhog locally) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@socialplatform.dev

# ---- Token encryption ----
# AES-256-GCM key used to encrypt stored social OAuth tokens at rest. Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=replace_with_openssl_rand_hex_32

# ---- Social OAuth (per-platform apps, launch scope) ----
# Instagram rides on the Facebook app below — Meta discovers the linked IG Business/Creator
# account through the Facebook Page during the same OAuth grant, there's no separate app.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- AI ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SENTRY_DSN=
